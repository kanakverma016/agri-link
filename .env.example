# Firebase web config (Project settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only keys (never exposed to the browser; used by /api routes)
OPENWEATHER_API_KEY=
NEWSDATA_API_KEY=
GEMINI_API_KEY=

# Google Maps JS key (browser key - restrict by HTTP referrer in Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: server-side geocoding key (falls back to the browser key) and Gemini model override
GOOGLE_MAPS_SERVER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
