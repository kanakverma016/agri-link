# Supabase (injected by the Vercel Supabase integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only keys (never exposed to the browser; used by /api routes)
OPENWEATHER_API_KEY=
# Optional comma-separated backup keys, tried when the primary key is rejected
OPENWEATHER_API_KEY_FALLBACKS=
NEWSDATA_API_KEY=
GEMINI_API_KEY=
# Optional comma-separated backup keys, tried in order when the primary hits quota or is rejected
GEMINI_API_KEY_FALLBACKS=

# Google Maps key. GCP_API_KEY_2 is used for both geocoding and the browser map
# (next.config maps it to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY). Restrict it by HTTP referrer.
GCP_API_KEY_2=
# Google Maps JS key (browser key - restrict by HTTP referrer in Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: server-side geocoding key (falls back to the browser key) and Gemini model override
GOOGLE_MAPS_SERVER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
