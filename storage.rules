rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function underLimit() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && underLimit();
    }

    match /posts/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && underLimit();
    }

    match /b2b-listings/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && underLimit();
    }

    match /chatImages/{chatId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && underLimit();
    }
  }
}
